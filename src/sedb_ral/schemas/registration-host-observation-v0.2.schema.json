{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/sedb-ral/registration-host-observation-v0.2.schema.json",
  "title": "SEDB-RAL Registration Host Observation v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "observation_id", "provider", "adapter_kind",
    "identifier_kind", "native_thread_id", "native_session_id",
    "native_turn_id", "unavailable_fields", "observed_origin",
    "observed_at_ref", "applicant_item_ref", "applicant_item_evidence_ref",
    "applicant_item_evidence_digest", "canonical_claim_digest",
    "not_claimed", "observation_digest"
  ],
  "properties": {
    "schema": {"const": "sedb-ral.registration-host-observation/0.2"},
    "observation_id": {"type": "string", "minLength": 1},
    "provider": {"const": "openai"},
    "adapter_kind": {"const": "codex_app_task_tool"},
    "identifier_kind": {"const": "codex_thread"},
    "native_thread_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "native_session_id": {"const": null},
    "native_turn_id": {"type": "string", "minLength": 1},
    "unavailable_fields": {
      "const": [
        {
          "field": "native_session_id",
          "reason": "structurally_unavailable_from_codex_app_task_tool"
        }
      ]
    },
    "observed_origin": {"type": "string", "pattern": "^host:", "minLength": 6},
    "observed_at_ref": {"type": "string", "minLength": 1},
    "applicant_item_ref": {"type": "string", "minLength": 1},
    "applicant_item_evidence_ref": {"type": "string", "minLength": 1},
    "applicant_item_evidence_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "canonical_claim_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "not_claimed": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "contains": {"const": "pre_turn_output_enforcement"},
      "items": {"type": "string", "minLength": 1}
    },
    "observation_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}
  }
}
