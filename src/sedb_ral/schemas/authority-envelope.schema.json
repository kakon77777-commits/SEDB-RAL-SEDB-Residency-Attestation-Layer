{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/sedb-ral/authority-envelope.schema.json",
  "title": "SEDB-RAL Authority Envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority_id", "principal_ref", "subject_kind", "subject_ref", "scopes", "status", "issued_time_ref", "revoked_by_event", "authorship_attestation_ref"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "authority_id": {"type": "string", "minLength": 1},
    "principal_ref": {"type": "string", "minLength": 1},
    "subject_kind": {"enum": ["application_digest", "resident_id"]},
    "subject_ref": {"type": "string", "minLength": 1},
    "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["active", "revoked", "expired", "suspended"]},
    "issued_time_ref": {"type": "string", "minLength": 1},
    "revoked_by_event": {"type": ["string", "null"]},
    "authorship_attestation_ref": {"type": "string", "minLength": 1}
  }
}
