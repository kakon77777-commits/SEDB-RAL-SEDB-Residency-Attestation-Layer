{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/sedb-ral/registry-restore-receipt.schema.json",
  "title": "SEDB-RAL isolated restore rehearsal receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "rehearsal_id", "registry_id", "checkpoint_digest",
    "source_snapshot_digest", "restored_snapshot_digest",
    "production_digest_before", "production_digest_after", "restored",
    "restored_event_count", "created_time_ref", "not_claimed", "receipt_digest"
  ],
  "properties": {
    "schema": {"const": "sedb-ral.registry-restore-receipt/0.1"},
    "rehearsal_id": {"type": "string", "pattern": "^restore:[0-9a-f-]{36}$"},
    "registry_id": {"type": "string", "pattern": "^registry:[0-9a-f-]{36}$"},
    "checkpoint_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "source_snapshot_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "restored_snapshot_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "production_digest_before": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "production_digest_after": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "restored": {"const": true},
    "restored_event_count": {"const": 0},
    "created_time_ref": {"type": "string", "minLength": 1},
    "not_claimed": {"const": ["production_mutation", "offsite_recovery", "private_restore"]},
    "receipt_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}
  }
}
