{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/sedb-ral/registrar-operation-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation_id", "request_digest", "policy_digest", "operations_generation", "registry_id", "pre_head", "post_head", "outcome", "registrar_receipt_ref", "registrar_receipt_digest", "projection_ref", "projection_digest", "error_codes", "side_effect_counters", "completed_time_ref", "not_claimed", "receipt_digest"],
  "properties": {
    "schema": {"const": "sedb-ral.registrar-operation-receipt/0.1"},
    "operation_id": {"type": "string", "minLength": 1},
    "request_digest": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "minLength": 1},
    "operations_generation": {"type": "string", "minLength": 1},
    "registry_id": {"type": "string", "minLength": 1},
    "pre_head": {"type": ["string", "null"], "minLength": 1},
    "post_head": {"type": ["string", "null"], "minLength": 1},
    "outcome": {"enum": ["complete", "rejected", "deferred", "recovery_required", "quarantined"]},
    "registrar_receipt_ref": {"type": ["string", "null"], "minLength": 1},
    "registrar_receipt_digest": {"type": ["string", "null"], "minLength": 1},
    "projection_ref": {"type": ["string", "null"], "minLength": 1},
    "projection_digest": {"type": ["string", "null"], "minLength": 1},
    "error_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "side_effect_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic_registry_writes", "production_registry_writes", "private_reads", "network_calls", "external_sends", "fabric_events"],
      "properties": {
        "synthetic_registry_writes": {"type": "integer", "minimum": 0},
        "production_registry_writes": {"const": 0},
        "private_reads": {"const": 0},
        "network_calls": {"const": 0},
        "external_sends": {"const": 0},
        "fabric_events": {"const": 0}
      }
    },
    "completed_time_ref": {"type": "string", "minLength": 1},
    "not_claimed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "receipt_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}
  }
}
