{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/sedb-ral/registration-wave-prepared-candidate.schema.json",
  "title": "SEDB-RAL Registration Wave Prepared Candidate v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "candidate_id", "claim_ref", "canonical_claim_digest",
    "item_evidence_ref", "item_evidence_digest", "host_v02_ref",
    "host_v02_digest", "compatibility_host_v01_ref",
    "compatibility_host_v01_digest", "prepared_registration_ref",
    "prepared_registration_digest", "application_ref", "application_digest",
    "canonical_locator", "not_claimed", "candidate_digest"
  ],
  "properties": {
    "schema": {"const": "sedb-ral.registration-wave-prepared-candidate/0.1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "claim_ref": {"type": "string", "minLength": 1},
    "canonical_claim_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "item_evidence_ref": {"type": "string", "minLength": 1},
    "item_evidence_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "host_v02_ref": {"type": "string", "minLength": 1},
    "host_v02_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "compatibility_host_v01_ref": {"type": "string", "minLength": 1},
    "compatibility_host_v01_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "prepared_registration_ref": {"type": "string", "minLength": 1},
    "prepared_registration_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "application_ref": {"type": "string", "minLength": 1},
    "application_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "canonical_locator": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "not_claimed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidate_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}
  }
}
