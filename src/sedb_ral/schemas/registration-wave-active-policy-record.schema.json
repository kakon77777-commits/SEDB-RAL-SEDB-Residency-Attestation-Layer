{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/sedb-ral/registration-wave-active-policy-record.schema.json",
  "title": "SEDB-RAL Registration Wave Active Policy Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "record_id", "sequence", "predecessor_record_ref",
    "predecessor_record_digest", "dormant_policy_digest", "wave_policy_ref",
    "wave_policy_digest", "registry_generation_digest", "extension_index_digest",
    "checkpoint_ref", "checkpoint_digest", "activation_authority_ref",
    "activation_authority_digest", "activation_request_ref",
    "activation_request_digest", "status", "valid_until_ref", "not_claimed",
    "record_digest"
  ],
  "properties": {
    "schema": {"const": "sedb-ral.registration-wave-active-policy-record/0.1"},
    "record_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "predecessor_record_ref": {"type": "string", "minLength": 1},
    "predecessor_record_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "dormant_policy_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "wave_policy_ref": {"type": "string", "minLength": 1},
    "wave_policy_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "registry_generation_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "extension_index_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "checkpoint_ref": {"type": "string", "minLength": 1},
    "checkpoint_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "activation_authority_ref": {"type": "string", "minLength": 1},
    "activation_authority_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "activation_request_ref": {"type": "string", "minLength": 1},
    "activation_request_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "status": {"enum": ["active", "stopped", "completed", "expired", "revoked"]},
    "valid_until_ref": {"type": "string", "minLength": 1},
    "not_claimed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "record_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}
  }
}
