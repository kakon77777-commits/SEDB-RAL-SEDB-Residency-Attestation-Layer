{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/sedb-ral/registration-wave-slot-recovery-authorization.schema.json",
  "title": "SEDB-RAL Registration Wave Slot Recovery Authorization v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "recovery_authorization_id", "principal_ref", "wave_plan_ref",
    "wave_plan_digest", "slot_id", "slot_request_ref", "slot_request_digest",
    "original_execution_authorization_ref",
    "original_execution_authorization_digest", "application_approval_ref",
    "application_approval_digest", "verified_prefix_digest", "pre_head",
    "post_head", "checkpoint_ref", "checkpoint_digest",
    "current_readback_digest", "valid_from_ref", "expires_at_ref", "status",
    "revoked_by_ref", "source_user_item_ref", "source_user_item_digest",
    "host_observation_ref", "host_observation_digest", "not_claimed",
    "recovery_authorization_digest"
  ],
  "properties": {
    "schema": {"const": "sedb-ral.registration-wave-slot-recovery-authorization/0.1"},
    "recovery_authorization_id": {"type": "string", "minLength": 1},
    "principal_ref": {"type": "string", "minLength": 1},
    "wave_plan_ref": {"type": "string", "minLength": 1},
    "wave_plan_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "slot_id": {"type": "string", "minLength": 1},
    "slot_request_ref": {"type": "string", "minLength": 1},
    "slot_request_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "original_execution_authorization_ref": {"type": "string", "minLength": 1},
    "original_execution_authorization_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "application_approval_ref": {"type": "string", "minLength": 1},
    "application_approval_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "verified_prefix_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "pre_head": {"type": ["string", "null"], "minLength": 1},
    "post_head": {"type": "string", "minLength": 1},
    "checkpoint_ref": {"type": "string", "minLength": 1},
    "checkpoint_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "current_readback_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "valid_from_ref": {"type": "string", "minLength": 1},
    "expires_at_ref": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "revoked", "expired", "suspended"]},
    "revoked_by_ref": {"type": ["string", "null"], "minLength": 1},
    "source_user_item_ref": {"type": "string", "minLength": 1},
    "source_user_item_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "host_observation_ref": {"type": "string", "minLength": 1},
    "host_observation_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "not_claimed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "recovery_authorization_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}
  }
}
