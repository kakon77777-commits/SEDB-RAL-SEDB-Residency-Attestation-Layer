{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/sedb-ral/registration-host-observation.schema.json",
  "title": "SEDB-RAL Registration Host Observation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observation_id",
    "provider",
    "adapter_kind",
    "identifier_kind",
    "native_thread_id",
    "native_session_id",
    "native_turn_id",
    "unavailable_fields",
    "observed_origin",
    "observed_at_ref",
    "applicant_item_ref",
    "not_claimed"
  ],
  "properties": {
    "schema": {"const": "sedb-ral.registration-host-observation/0.1"},
    "observation_id": {"type": "string", "minLength": 1},
    "provider": {"const": "openai"},
    "adapter_kind": {
      "enum": ["codex_app_task_tool", "codex_app_server"]
    },
    "identifier_kind": {"const": "codex_thread"},
    "native_thread_id": {"type": "string", "minLength": 1},
    "native_session_id": {"type": ["string", "null"], "minLength": 1},
    "native_turn_id": {"type": "string", "minLength": 1},
    "unavailable_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "reason"],
        "properties": {
          "field": {"const": "native_session_id"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "observed_origin": {
      "type": "string",
      "minLength": 6,
      "pattern": "^host:"
    },
    "observed_at_ref": {"type": "string", "minLength": 1},
    "applicant_item_ref": {"type": "string", "minLength": 1},
    "not_claimed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {"const": "pre_turn_output_enforcement"},
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "adapter_kind": {"const": "codex_app_task_tool"}
        },
        "required": ["adapter_kind"]
      },
      "then": {
        "properties": {
          "native_session_id": {"const": null},
          "unavailable_fields": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "reason"],
              "properties": {
                "field": {"const": "native_session_id"},
                "reason": {
                  "const": "structurally_unavailable_from_codex_app_task_tool"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "native_session_id": {"type": "string", "minLength": 1},
          "unavailable_fields": {"maxItems": 0}
        }
      }
    }
  ]
}
