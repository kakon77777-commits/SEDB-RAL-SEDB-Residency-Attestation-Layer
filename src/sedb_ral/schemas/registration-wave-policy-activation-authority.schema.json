{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/sedb-ral/registration-wave-policy-activation-authority.schema.json",
  "title": "SEDB-RAL Registration Wave Policy Activation Authority v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "authority_id", "principal_ref", "operation", "request_ref",
    "request_digest", "policy_ref", "policy_digest", "target_ref",
    "valid_from_ref", "expires_at_ref", "status", "revoked_by_ref",
    "source_user_item_ref", "source_user_item_digest", "host_observation_ref",
    "host_observation_digest", "not_claimed", "authority_digest"
  ],
  "properties": {
    "schema": {"const": "sedb-ral.registration-wave-policy-activation-authority/0.1"},
    "authority_id": {"type": "string", "minLength": 1},
    "principal_ref": {"type": "string", "minLength": 1},
    "operation": {"const": "registration.wave-policy.activate"},
    "request_ref": {"type": "string", "minLength": 1},
    "request_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "policy_ref": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "target_ref": {"type": "string", "minLength": 1},
    "valid_from_ref": {"type": "string", "minLength": 1},
    "expires_at_ref": {"type": ["string", "null"], "minLength": 1},
    "status": {"enum": ["active", "revoked", "expired", "suspended"]},
    "revoked_by_ref": {"type": ["string", "null"], "minLength": 1},
    "source_user_item_ref": {"type": "string", "minLength": 1},
    "source_user_item_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "host_observation_ref": {"type": "string", "minLength": 1},
    "host_observation_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "not_claimed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}
  }
}
