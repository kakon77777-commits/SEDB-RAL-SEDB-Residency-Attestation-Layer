{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/sedb-ral/registration-slot-execution-authorization.schema.json",
  "title": "SEDB-RAL Registration Slot Execution Authorization v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "execution_authorization_id", "principal_ref", "wave_plan_ref",
    "wave_plan_digest", "slot_id", "slot_index", "operation_request_ref",
    "operation_request_digest", "application_approval_ref",
    "application_approval_digest", "policy_ref", "policy_digest",
    "checkpoint_ref", "checkpoint_digest", "expected_ledger_head",
    "registry_control_digest", "valid_from_ref", "expires_at_ref", "status",
    "revoked_by_ref", "source_user_item_ref", "source_user_item_digest",
    "host_observation_ref", "host_observation_digest", "not_claimed",
    "execution_authorization_digest"
  ],
  "properties": {
    "schema": {"const": "sedb-ral.registration-slot-execution-authorization/0.1"},
    "execution_authorization_id": {"type": "string", "minLength": 1},
    "principal_ref": {"type": "string", "minLength": 1},
    "wave_plan_ref": {"type": "string", "minLength": 1},
    "wave_plan_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "slot_id": {"type": "string", "minLength": 1},
    "slot_index": {"enum": [1, 2, 3]},
    "operation_request_ref": {"type": "string", "minLength": 1},
    "operation_request_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "application_approval_ref": {"type": "string", "minLength": 1},
    "application_approval_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "policy_ref": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "checkpoint_ref": {"type": "string", "minLength": 1},
    "checkpoint_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "expected_ledger_head": {"type": ["string", "null"], "minLength": 1},
    "registry_control_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "valid_from_ref": {"type": "string", "minLength": 1},
    "expires_at_ref": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "revoked", "expired", "suspended"]},
    "revoked_by_ref": {"type": ["string", "null"], "minLength": 1},
    "source_user_item_ref": {"type": "string", "minLength": 1},
    "source_user_item_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "host_observation_ref": {"type": "string", "minLength": 1},
    "host_observation_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "not_claimed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "execution_authorization_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}
  }
}
