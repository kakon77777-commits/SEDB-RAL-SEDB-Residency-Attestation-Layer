{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/sedb-ral/production-operations-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "allowed_operation_kinds", "intake_enabled", "execution_enabled", "capabilities", "not_claimed", "policy_digest"],
  "properties": {
    "schema": {"const": "sedb-ral.production-operations-policy/0.1"},
    "policy_id": {"const": "policy:production-dormant-v1"},
    "allowed_operation_kinds": {"const": ["inspect", "status"]},
    "intake_enabled": {"const": false},
    "execution_enabled": {"const": false},
    "capabilities": {
      "const": {
        "ledger_append": false,
        "real_applicant": false,
        "private_access": false,
        "network_send": false,
        "provider_call": false,
        "fabric_emit": false,
        "mcp_call": false
      }
    },
    "not_claimed": {"const": ["registrar_authority", "resident_registration", "private_access"]},
    "policy_digest": {"type": "string", "minLength": 1}
  }
}
