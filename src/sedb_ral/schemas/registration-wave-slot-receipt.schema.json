{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/sedb-ral/registration-wave-slot-receipt.schema.json",
  "title": "SEDB-RAL Registration Wave Slot Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "receipt_id", "wave_plan_ref", "wave_plan_digest", "slot_id",
    "slot_index", "slot_request_ref", "slot_request_digest",
    "execution_authorization_ref", "execution_authorization_digest",
    "application_approval_ref", "application_approval_digest", "pre_head",
    "post_head", "appended_events", "projection_digests", "commit_receipt_ref",
    "commit_receipt_digest", "operation_receipt_ref", "operation_receipt_digest",
    "event_count_delta", "limen_b6a_status", "limen_b6a_result_ref",
    "limen_b6a_result_digest", "effect_deltas", "status", "not_claimed",
    "receipt_digest"
  ],
  "properties": {
    "schema": {"const": "sedb-ral.registration-wave-slot-receipt/0.1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "wave_plan_ref": {"type": "string", "minLength": 1},
    "wave_plan_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "slot_id": {"type": "string", "minLength": 1},
    "slot_index": {"enum": [1, 2, 3]},
    "slot_request_ref": {"type": "string", "minLength": 1},
    "slot_request_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "execution_authorization_ref": {"type": "string", "minLength": 1},
    "execution_authorization_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "application_approval_ref": {"type": "string", "minLength": 1},
    "application_approval_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "pre_head": {"type": ["string", "null"], "minLength": 1},
    "post_head": {"type": "string", "minLength": 1},
    "appended_events": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["event_ref", "event_digest"], "properties": {"event_ref": {"type": "string", "minLength": 1}, "event_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}}}},
    "projection_digests": {"type": "object", "additionalProperties": false, "required": ["application", "resident", "instance", "address", "binding"], "properties": {"application": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}, "resident": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}, "instance": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}, "address": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}, "binding": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}}},
    "commit_receipt_ref": {"type": "string", "minLength": 1},
    "commit_receipt_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "operation_receipt_ref": {"type": "string", "minLength": 1},
    "operation_receipt_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "event_count_delta": {"type": "integer", "minimum": 0},
    "limen_b6a_status": {"enum": ["pending", "current", "stale", "conflicting"]},
    "limen_b6a_result_ref": {"type": ["string", "null"], "minLength": 1},
    "limen_b6a_result_digest": {"type": ["string", "null"], "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "effect_deltas": {"type": "object", "additionalProperties": false, "required": ["resident", "application", "address", "private", "network", "external"], "properties": {"resident": {"type": "integer", "minimum": 0}, "application": {"type": "integer", "minimum": 0}, "address": {"type": "integer", "minimum": 0}, "private": {"const": 0}, "network": {"const": 0}, "external": {"const": 0}}},
    "status": {"enum": ["accepted", "canonical_committed_readback_failed", "recovered", "refused_no_append"]},
    "not_claimed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "receipt_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}
  }
}
