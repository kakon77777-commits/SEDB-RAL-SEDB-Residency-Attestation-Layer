{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/sedb-ral/registration-wave-policy-activation-receipt.schema.json",
  "title": "SEDB-RAL Registration Wave Policy Activation Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "receipt_id", "policy_ref", "policy_digest",
    "active_policy_ref", "active_policy_digest", "predecessor_record_ref",
    "predecessor_record_digest", "registry_generation_digest",
    "extension_index_digest", "checkpoint_ref", "checkpoint_digest",
    "authority_ref", "authority_digest", "request_ref", "request_digest",
    "application_approval_digests", "acl_observation_ref",
    "acl_observation_digest", "pre_status_digest", "post_status_digest",
    "status", "observed_at_ref", "not_claimed", "receipt_digest"
  ],
  "properties": {
    "schema": {"const": "sedb-ral.registration-wave-policy-activation-receipt/0.1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "policy_ref": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "active_policy_ref": {"type": "string", "minLength": 1},
    "active_policy_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "predecessor_record_ref": {"type": "string", "minLength": 1},
    "predecessor_record_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "registry_generation_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "extension_index_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "checkpoint_ref": {"type": "string", "minLength": 1},
    "checkpoint_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "authority_ref": {"type": "string", "minLength": 1},
    "authority_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "request_ref": {"type": "string", "minLength": 1},
    "request_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "application_approval_digests": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}},
    "acl_observation_ref": {"type": "string", "minLength": 1},
    "acl_observation_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "pre_status_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "post_status_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "status": {"const": "activated"},
    "observed_at_ref": {"type": "string", "minLength": 1},
    "not_claimed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "receipt_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}
  }
}
