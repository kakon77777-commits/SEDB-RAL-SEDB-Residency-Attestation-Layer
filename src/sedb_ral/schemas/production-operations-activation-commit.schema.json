{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/sedb-ral/production-operations-activation-commit.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "candidate_id", "plan_digest", "authority_digest", "manifest_digest", "policy_digest", "pre_checkpoint_digest", "committed_time_ref", "not_claimed", "commit_digest"],
  "properties": {
    "schema": {"const": "sedb-ral.production-operations-activation-commit/0.1"},
    "candidate_id": {"type": "string", "format": "uuid"},
    "plan_digest": {"type": "string", "minLength": 1},
    "authority_digest": {"type": "string", "minLength": 1},
    "manifest_digest": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "minLength": 1},
    "pre_checkpoint_digest": {"type": "string", "minLength": 1},
    "committed_time_ref": {"type": "string", "minLength": 1},
    "not_claimed": {"const": ["published", "ledger_append", "resident_registration", "private_access"]},
    "commit_digest": {"type": "string", "minLength": 1}
  }
}
