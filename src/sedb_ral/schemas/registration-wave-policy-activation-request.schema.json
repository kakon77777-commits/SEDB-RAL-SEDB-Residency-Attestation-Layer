{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/sedb-ral/registration-wave-policy-activation-request.schema.json",
  "title": "SEDB-RAL Registration Wave Policy Activation Request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "request_id", "wave_plan_ref", "wave_plan_digest",
    "policy_ref", "policy_digest", "application_approval_digests",
    "expected_predecessor_record_ref", "expected_predecessor_record_digest",
    "registry_generation_digest", "checkpoint_ref", "checkpoint_digest",
    "requested_at_ref", "not_claimed", "request_digest"
  ],
  "properties": {
    "schema": {"const": "sedb-ral.registration-wave-policy-activation-request/0.1"},
    "request_id": {"type": "string", "minLength": 1},
    "wave_plan_ref": {"type": "string", "minLength": 1},
    "wave_plan_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "policy_ref": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "application_approval_digests": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}},
    "expected_predecessor_record_ref": {"type": "string", "minLength": 1},
    "expected_predecessor_record_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "registry_generation_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "checkpoint_ref": {"type": "string", "minLength": 1},
    "checkpoint_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"},
    "requested_at_ref": {"type": "string", "minLength": 1},
    "not_claimed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "request_digest": {"type": "string", "pattern": "^sha256:sedb-ral-json-nfc-codepoint-v1:[0-9a-f]{64}$"}
  }
}
